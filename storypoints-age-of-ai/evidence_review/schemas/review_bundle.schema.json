{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hadr/evidence-review-bundle.schema.json",
  "title": "HADR Gate 2 evidence-review bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "search_runs", "records", "deduplication_decisions", "agent_screenings", "adjudications", "study_families", "citation_chases", "quality_appraisals", "extractions", "citation_confirmations", "prisma_events"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "metadata": {
      "type": "object",
      "required": ["review_id", "protocol_version", "review_design", "evidence_coverage", "search_cutoff_date", "status", "accountable_author_ids", "search_completion", "coverage_contract", "novelty_claim_contract"],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "protocol_version": {"type": "string", "minLength": 1},
        "review_design": {"const": "ai_assisted_systematic_evidence_map_open_indexes"},
        "evidence_coverage": {"const": "access_constrained"},
        "search_cutoff_date": {"type": ["string", "null"], "format": "date"},
        "status": {"enum": ["template_no_study_decisions", "in_progress", "frozen_complete"]},
        "accountable_author_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "search_completion": {"type": "object", "required": ["systematic_searches_complete", "update_search_complete"], "properties": {"systematic_searches_complete": {"type": "boolean"}, "update_search_complete": {"type": "boolean"}}},
        "coverage_contract": {"type": "object", "required": ["required_search_family_ids", "required_source_ids", "required_search_pairs", "approved_unavailable_sources"], "properties": {"required_search_family_ids": {"type": "array", "items": {"type": "string"}}, "required_source_ids": {"type": "array", "items": {"type": "string"}}, "required_search_pairs": {"type": "array", "items": {"type": "object", "required": ["source", "search_family"], "properties": {"source": {"type": "string"}, "search_family": {"type": "string"}}}}, "approved_unavailable_sources": {"type": "array", "items": {"type": "object", "required": ["source", "deviation_id", "access_state", "attempted_at_utc", "rationale", "approved_by_author_id"], "properties": {"source": {"type": "string"}, "deviation_id": {"type": "string"}, "access_state": {"enum": ["blocked_authentication", "blocked_rate_limit", "blocked_technical"]}, "attempted_at_utc": {"type": "string", "format": "date-time"}, "rationale": {"type": "string"}, "approved_by_author_id": {"type": "string"}}}}}},
        "novelty_claim_contract": {"type": "object", "required": ["allowed_statement", "reported_statement"], "properties": {"allowed_statement": {"const": "No substantively duplicative framework was identified within the predeclared open scholarly indexes, repositories, and citation networks searched through the stated cutoff date."}, "reported_statement": {"type": ["string", "null"]}, "prohibited_unbounded_claims": {"type": "array", "items": {"type": "string"}}}},
        "notice": {"type": "string"}
      }
    },
    "search_runs": {"type": "array", "items": {"type": "object", "required": ["search_run_id", "source", "search_family", "exact_query", "executed_at_utc", "status", "results_returned", "export_checksum"], "properties": {"search_run_id": {"type": "string"}, "source": {"type": "string"}, "search_family": {"type": "string"}, "exact_query": {"type": "string"}, "executed_at_utc": {"type": "string", "format": "date-time"}, "status": {"enum": ["approved_systematic", "pilot_excluded", "update_systematic"]}, "results_returned": {"type": ["integer", "null"], "minimum": 0}, "export_checksum": {"type": ["string", "null"]}, "operator_id": {"type": ["string", "null"]}, "deviation_id": {"type": ["string", "null"]}}}},
    "records": {"type": "array", "items": {"type": "object", "required": ["record_id", "title", "source_type", "retrieval_batch_id", "evidence_stratum", "publication_status", "full_text_access_status"], "properties": {"record_id": {"type": "string"}, "title": {"type": "string"}, "source_type": {"enum": ["scholarly_database", "other_method", "method_reference"]}, "evidence_stratum": {"enum": ["peer_reviewed_scholarly", "preprint_scholarly", "grey_practitioner", "method_reference"]}, "publication_status": {"type": "string"}, "retrieval_batch_id": {"type": "string"}, "doi": {"type": ["string", "null"]}, "arxiv_id": {"type": ["string", "null"]}, "url": {"type": ["string", "null"]}, "metadata_checksum": {"type": ["string", "null"]}, "full_text_access_status": {"enum": ["not_sought", "lawful_open_full_text", "lawful_author_manuscript", "lawful_preprint_version", "authorized_subscription_access", "unavailable_paywall", "unavailable_other"]}, "full_text_locator": {"type": ["string", "null"]}, "full_text_access_checked_at_utc": {"type": ["string", "null"], "format": "date-time"}, "full_text_access_checked_by": {"type": ["string", "null"]}}}},
    "deduplication_decisions": {"type": "array", "items": {"type": "object", "required": ["deduplication_id", "removed_record_id", "retained_record_id", "match_basis", "evidence", "decider_id", "decided_at_utc"], "properties": {"deduplication_id": {"type": "string"}, "removed_record_id": {"type": "string"}, "retained_record_id": {"type": "string"}, "match_basis": {"enum": ["doi", "arxiv_related_doi", "title_author_year", "manual_exact_duplicate"]}, "evidence": {"type": "string"}, "decider_id": {"type": "string"}, "decided_at_utc": {"type": "string", "format": "date-time"}}}},
    "agent_screenings": {"type": "array", "items": {"type": "object", "required": ["screening_id", "record_id", "stage", "review_pass_id", "reviewer_type", "reviewer_id", "model_prompt_version", "review_context_id", "prior_screening_decisions_visible", "input_checksum", "decision", "reason", "confidence", "source_locator", "independence_attestation"], "properties": {"screening_id": {"type": "string"}, "record_id": {"type": "string"}, "stage": {"enum": ["title_abstract", "full_text"]}, "review_pass_id": {"type": "string"}, "reviewer_type": {"const": "ai_agent"}, "reviewer_id": {"type": "string"}, "model_prompt_version": {"type": "string"}, "review_context_id": {"type": "string"}, "prior_screening_decisions_visible": {"const": false}, "input_checksum": {"type": "string"}, "decision": {"enum": ["include", "exclude", "unclear"]}, "reason": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "source_locator": {"type": "string"}, "independence_attestation": {"type": "string", "minLength": 20}}}},
    "adjudications": {"type": "array", "items": {"type": "object", "required": ["adjudication_id", "record_id", "stage", "adjudicator_id", "review_context_id", "decision", "rationale", "source_locator"], "properties": {"adjudication_id": {"type": "string"}, "record_id": {"type": "string"}, "stage": {"enum": ["title_abstract", "full_text"]}, "adjudicator_id": {"type": "string"}, "review_context_id": {"type": "string"}, "decision": {"enum": ["include", "exclude"]}, "exclusion_code": {"type": ["string", "null"]}, "rationale": {"type": "string"}, "source_locator": {"type": "string"}}}},
    "study_families": {"type": "array", "items": {"type": "object", "required": ["family_id", "member_record_ids", "representative_record_id", "consolidation_basis", "linkage_signals", "family_reviewer_agent_id", "status"], "properties": {"family_id": {"type": "string"}, "member_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "representative_record_id": {"type": "string"}, "consolidation_basis": {"type": "string"}, "linkage_signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["singleton", "doi_relation", "arxiv_related_doi", "title_author_year", "explicit_version_statement", "shared_sample_project", "correction_companion", "manual_other"]}}, "family_reviewer_agent_id": {"type": "string"}, "status": {"enum": ["candidate", "consolidated", "included_final", "excluded_final"]}, "author_source_confirmation_status": {"enum": ["pending", "confirmed", "rejected"]}, "accountable_author_id": {"type": ["string", "null"]}, "confirmed_at_utc": {"type": ["string", "null"], "format": "date-time"}}}},
    "citation_chases": {"type": "array", "items": {"type": "object", "required": ["chase_id", "seed_family_id", "seed_record_id", "direction", "provider", "search_run_id", "executed_at_utc", "raw_export_checksum", "discovered_record_ids"], "properties": {"chase_id": {"type": "string"}, "seed_family_id": {"type": "string"}, "seed_record_id": {"type": "string"}, "direction": {"enum": ["backward", "forward"]}, "provider": {"type": "string"}, "search_run_id": {"type": "string"}, "executed_at_utc": {"type": "string", "format": "date-time"}, "raw_export_checksum": {"type": "string"}, "discovered_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "query_or_endpoint": {"type": ["string", "null"]}, "notes": {"type": ["string", "null"]}}}},
    "quality_appraisals": {"type": "array", "items": {"type": "object", "required": ["appraisal_id", "family_id", "appraisal_form", "appraiser_agent_id", "applicable_points", "points_awarded", "critical_flaw", "evidence_band", "source_locators"], "properties": {"appraisal_id": {"type": "string"}, "family_id": {"type": "string"}, "appraisal_form": {"enum": ["quantitative_mixed", "qualitative", "secondary_review", "conceptual_framework", "grey_aacods"]}, "appraiser_agent_id": {"type": "string"}, "applicable_points": {"type": "integer", "minimum": 1}, "points_awarded": {"type": "integer", "minimum": 0}, "critical_flaw": {"type": "boolean"}, "evidence_band": {"enum": ["high", "moderate", "low_contextual"]}, "source_locators": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "notes": {"type": ["string", "null"]}}}},
    "extractions": {"type": "array", "items": {"type": "object", "required": ["extraction_id", "family_id", "source_record_id", "claim_id", "field_name", "value", "data_nature", "source_locator", "extractor_agent_id", "verification_status"], "properties": {"extraction_id": {"type": "string"}, "family_id": {"type": "string"}, "source_record_id": {"type": "string"}, "claim_id": {"type": "string"}, "field_name": {"type": "string"}, "value": {}, "unit": {"type": ["string", "null"]}, "data_nature": {"enum": ["observed", "self_reported", "modeled", "conceptual", "mixed"]}, "source_locator": {"type": "string"}, "extractor_agent_id": {"type": "string"}, "verifier_agent_id": {"type": ["string", "null"]}, "verification_status": {"enum": ["candidate", "verified", "rejected"]}, "notes": {"type": ["string", "null"]}}}},
    "citation_confirmations": {"type": "array", "items": {"type": "object", "required": ["confirmation_id", "extraction_id", "citation_key", "status", "supports_claim", "accountable_author_id", "source_locator_checked", "confirmed_at_utc"], "properties": {"confirmation_id": {"type": "string"}, "extraction_id": {"type": "string"}, "citation_key": {"type": "string"}, "status": {"enum": ["pending", "confirmed", "rejected"]}, "supports_claim": {"type": ["boolean", "null"]}, "accountable_author_id": {"type": ["string", "null"]}, "source_locator_checked": {"type": ["string", "null"]}, "confirmed_at_utc": {"type": ["string", "null"], "format": "date-time"}, "author_note": {"type": ["string", "null"]}}}},
    "prisma_events": {"type": "array", "items": {"type": "object", "required": ["event_id", "event_index", "previous_event_id", "record_id", "action", "occurred_at_utc", "actor_id", "basis"], "properties": {"event_id": {"type": "string"}, "event_index": {"type": "integer", "minimum": 0}, "previous_event_id": {"type": ["string", "null"]}, "record_id": {"type": "string"}, "action": {"enum": ["identified_database", "identified_other", "duplicate_removed", "screened_title_abstract", "excluded_title_abstract", "sought_full_text", "full_text_unavailable", "assessed_full_text", "excluded_full_text", "included_report"]}, "occurred_at_utc": {"type": "string", "format": "date-time"}, "actor_id": {"type": "string"}, "basis": {"type": "string"}, "exclusion_code": {"type": ["string", "null"]}}}}
  }
}
