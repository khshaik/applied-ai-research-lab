{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ovar/outcome-evidence-ledger-v1.0.schema.json",
  "title": "OVAR reviewer-visible outcome-evidence ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "portfolio_id", "domain", "provenance", "project_stage", "workflow",
    "ai_intervention", "measurement_window_days", "approved_budget", "utilization_rate",
    "active_users", "token_units_m", "provider_cost", "infrastructure_cost", "tooling_cost",
    "human_review_cost", "integration_amortized_cost", "governance_cost", "rework_cost",
    "technical_quality", "owner_reported_gross_benefit", "outcome_contract_present",
    "outcome_contract", "observed_outcome_value", "baseline_estimated_outcome_value",
    "evidence_status", "baseline_design", "attribution_confidence", "uncertainty_half_width",
    "expected_harm_cost", "compliance_status", "evidence_review_cost", "access_class",
    "exploration_protected", "authoring_version"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^OV-P[0-9]{2}$"},
    "portfolio_id": {"type": "string", "pattern": "^PF-[A-D]$"},
    "domain": {"enum": ["HEALTHCARE", "FINANCIAL_SERVICES", "ECOMMERCE", "TRANSPORT_LOGISTICS", "CYBERSECURITY", "CUSTOMER_OPERATIONS"]},
    "provenance": {"const": "CONSTRUCTED"},
    "project_stage": {"enum": ["POC", "PILOT", "PRE_PRODUCTION"]},
    "workflow": {"type": "string", "minLength": 12},
    "ai_intervention": {"type": "string", "minLength": 12},
    "measurement_window_days": {"type": "integer", "minimum": 14, "maximum": 365},
    "approved_budget": {"type": "number", "exclusiveMinimum": 0},
    "utilization_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "active_users": {"type": "integer", "minimum": 1},
    "token_units_m": {"type": "number", "minimum": 0},
    "provider_cost": {"type": "number", "minimum": 0},
    "infrastructure_cost": {"type": "number", "minimum": 0},
    "tooling_cost": {"type": "number", "minimum": 0},
    "human_review_cost": {"type": "number", "minimum": 0},
    "integration_amortized_cost": {"type": "number", "minimum": 0},
    "governance_cost": {"type": "number", "minimum": 0},
    "rework_cost": {"type": "number", "minimum": 0},
    "technical_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "owner_reported_gross_benefit": {"type": "number"},
    "outcome_contract_present": {"type": "boolean"},
    "outcome_contract": {"type": "string"},
    "observed_outcome_value": {"type": "number"},
    "baseline_estimated_outcome_value": {"type": ["number", "null"]},
    "evidence_status": {"enum": ["VERIFIED", "PARTIAL", "UNVERIFIED"]},
    "baseline_design": {"enum": ["RANDOMIZED", "STEPPED_WEDGE", "MATCHED_CONCURRENT", "INTERRUPTED_TIME_SERIES", "BEFORE_AFTER_UNCONTROLLED", "NONE"]},
    "attribution_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty_half_width": {"type": "number", "minimum": 0},
    "expected_harm_cost": {"type": "number", "minimum": 0},
    "compliance_status": {"enum": ["PASS", "CONDITIONAL", "PROHIBITED"]},
    "evidence_review_cost": {"type": "number", "minimum": 0},
    "access_class": {"enum": ["STANDARD", "MINIMUM_ACCESS", "EXPLORATION"]},
    "exploration_protected": {"type": "boolean"},
    "authoring_version": {"const": "1.0"}
  }
}
