{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ovar/reviewer-response-v1.0.schema.json",
  "title": "OVAR pilot reviewer response",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "outcome_contract_clarity", "baseline_credibility", "evidence_auditability", "cost_boundary_completeness", "attribution_defensibility", "decision_realism", "leakage_flag", "ambiguity_flag", "missing_information", "boundary_rationale"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^OV-P[0-9]{2}$"},
    "outcome_contract_clarity": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "baseline_credibility": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "evidence_auditability": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "cost_boundary_completeness": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "attribution_defensibility": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "decision_realism": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "leakage_flag": {"enum": ["NO", "YES", "UNCERTAIN"]},
    "ambiguity_flag": {"enum": ["NO", "YES"]},
    "missing_information": {"type": "string"},
    "boundary_rationale": {"type": "string"}
  }
}
