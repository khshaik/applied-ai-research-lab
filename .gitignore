*~

# OS files
Thumbs.db
desktop.ini

# Generated data (keep structure, exclude actual data for privacy)
studies/cross-study/data/*.csv
studies/cross-study/data/*.json
studies/cross-study/results/*.json
!studies/cross-study/data/.gitkeep
!studies/cross-study/results/.gitkeep

# Manuscript binaries (keep source markdown only)
papers/thinkai-2026/manuscript/initial-submission/*.docx
papers/thinkai-2026/manuscript/initial-submission/*.pdf
papers/thinkai-2026/manuscript/camera-ready-submission/*.docx
papers/thinkai-2026/manuscript/camera-ready-submission/*.pdf
!papers/thinkai-2026/manuscript/.gitkeep

# Keep markdown and documentation
!*.md
!*.txt

# Keep all figures and images (publication quality)
!papers/thinkai-2026/figures/*.png
!papers/thinkai-2026/figures/*.jpg
!papers/thinkai-2026/figures/*.svg

# Keep all scripts
!scripts/*.py

# Keep artifacts
!artifacts/*.md

# Exclude sensitive information
*secret*
*password*
*token*
*credential*
*.pem
*.key
*.crt

# Exclude large files
*.zip
*.tar.gz
*.rar

# Exclude internal documentation (not needed in public repo)
EXECUTION_SUMMARY.md
PROJECT_EXECUTION_PLAN.md
PAPER_DRAFTING_COMPLETE.md
PROJECT_COMPLETE.md
README_UPDATES_COMPLETE.md
WORKFLOW_DIAGRAM_UPDATED.md
GITHUB_PUSH_READY.md
GIT_PUSH_INSTRUCTIONS.md
FILES_TO_COMMIT.md
CLEAN_PUSH_READY.md
push_to_github.sh

# Exclude any files with absolute paths or company references
**/OneDrive-Pepsico/**
*pepsico*
*PepsiCo*
